<Event>
<Name>On Preload</Name>
<Args/>
<Script>-- Get user's Documents Folder.
My_Docs = Shell.GetFolder(SHF_MYDOCUMENTS);

-- Open the database

local sqlite3 = require("luasql.sqlite3");

SQLite3Connection, err = SQLite3:connect(_SourceFolder .. "\\AutoPlay\\Docs\\citsrust.db");

SQLite3Connection:execute("CREATE TABLE IF NOT EXISTS RUSTDESK (id INTEGER PRIMARY KEY, Name TEXT, RustID TEXT)");</Script>
<TreeStates>
<TreeState>0</TreeState>
<TreeState>0</TreeState>
<TreeState>0</TreeState>
