<Object>
<Type>20</Type>
<Name>xButtonDelete9</Name>
<VisibleAtDesignTime>1</VisibleAtDesignTime>
<VisibleAtRunTime>1</VisibleAtRunTime>
<Locked>0</Locked>
<Enabled>1</Enabled>
<ToolTip>Delete Rustdesk user    </ToolTip>
<Cursor>0</Cursor>
<Group>0</Group>
<MaintainAspectRatio>0</MaintainAspectRatio>
<Pin>0</Pin>
<TabIndex>-1</TabIndex>
<AutoResize>0</AutoResize>
<Coordinates>
<Top>398</Top>
<Bottom>421</Bottom>
<Left>544</Left>
<Right>619</Right>
</Coordinates>
<Ratios>
<WidthRatio>-1.000000</WidthRatio>
<HeightRatio>-1.000000</HeightRatio>
</Ratios>
<Event>
<Name>On Click</Name>
<Args/>
<Script>-- Confirm that the installation executable should be launched.
result = Dialog.Message("Confirm", "Are you sure you would like to \ndelete this Rustdesk entry?", MB_YESNO, MB_ICONINFORMATION, MB_DEFBUTTON1);
-- If the user clicked the Yes button.
if (result == IDYES) then

-- Get the selected item from the ListBox
local xSel = ListBox.GetSelected("ListBox1")

-- Check if an item is selected
if xSel then
    -- Get the item data (ID) of the selected item
    local nData = ListBox.GetItemData("ListBox1", xSel[1])
    local n = tonumber(nData)  -- Convert the data to a number

    -- If the data is a valid number, perform the delete operation
    if type(n) == "number" then
    
        -- Delete the row from the database based on the selected ID

         SQLite3Connection:execute("DELETE FROM RUSTDESK WHERE id ="..n)
        
        
        -- Refresh the ListBox after deletion
        SearchAll()
    else
        -- Handle the case where the selected item ID is not a valid number (optional)
        -- Add error handling or message here if necessary
              
    end
else
    -- Handle the case where no item is selected in the ListBox (optional)
    -- Add error handling or message here if necessary
end
else
Dialog.Message("Info", "The user chose not to \ndelete this entry.", MB_OK, MB_ICONINFORMATION, MB_DEFBUTTON1)
end
</Script>
