</Event>
<Event>
<Name>On Shutdown</Name>
<Args/>
<Script>				-- gets current app position
		tPos = Window.GetPos(Application.GetWndHandle());
		
			
				--write this to registry
				Registry.SetValue(HKEY_CURRENT_USER, "Software\\ClassicIT\\RustdeskID\\Screen", "POSX", tPos.X, REG_SZ);
				Registry.SetValue(HKEY_CURRENT_USER, "Software\\ClassicIT\\RustdeskID\\Screen", "POSY", tPos.Y, REG_SZ);
		
		
</Script>
