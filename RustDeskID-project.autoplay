<Name>On Click</Name>
<Args/>
<Script>	current_date = System.GetDate(1);
	current_time = System.GetTime(TIME_FMT_AMPM);
    --current_date = String.ToNumber(current_date);

-- local nId = Input.GetText("Input1")
local text = Input.SetText("InputName2", " # New Client PLACEHOLDER");
local email = Input.SetText("Input3", current_date .. " " .. current_time);


-- Inserts a new DUMMY record into the RUSTDESK table with a text and the Rustdesk ID

local text = Input.GetText("InputName2")
local RustID = Input.GetText("Input3")

SQLite3Connection:execute("INSERT INTO RUSTDESK VALUES(NULL, '"..text.."','"..RustID.."')");

SearchAll();

</Script>
