<Script>local sqlite3 = require("luasql.sqlite3")
local db = sqlite3.open(_SourceFolder .. "\\AutoPlay\\Docs\\citsrust.db")
local file = io.open(_SourceFolder .. "\\AutoPlay\\Docs\\export_data.csv", "w")

-- Write CSV header
file:write("id,Name,RustID\n")

-- Fetch and write rows
for row in db:nrows("SELECT * FROM RUSTDESK") do
    file:write(string.format("%s,%s,%s\n", row.id, row.name, row.RustID))
end

file:close()
db:close()
print("Export complete!")</Script>
