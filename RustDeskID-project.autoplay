<Object>
<Type>20</Type>
<Name>xButtonBackup1</Name>
<VisibleAtDesignTime>1</VisibleAtDesignTime>
<VisibleAtRunTime>0</VisibleAtRunTime>
<Locked>0</Locked>
<Enabled>0</Enabled>
<ToolTip>Backup SQLite3 database</ToolTip>
<Cursor>0</Cursor>
<Group>0</Group>
<MaintainAspectRatio>0</MaintainAspectRatio>
<Pin>0</Pin>
<TabIndex>-1</TabIndex>
<AutoResize>0</AutoResize>
<Coordinates>
<Top>368</Top>
<Bottom>391</Bottom>
<Left>544</Left>
<Right>619</Right>
</Coordinates>
<Ratios>
<WidthRatio>-1.000000</WidthRatio>
<HeightRatio>-1.000000</HeightRatio>
</Ratios>
<Event>
<Name>On Click</Name>
<Args/>
<Script>-- Confirm that the installation executable should be launched.
result = Dialog.Message("Confirm", "Are you sure you would like to \nbackup this Rustdesk SQLite database?", MB_YESNO, MB_ICONINFORMATION, MB_DEFBUTTON1);
-- If the user clicked the Yes button.
if (result == IDYES) then

		File.Copy(_SourceDrive .."\\RustDeskID\\AutoPlay\\Docs\\citsrust.db", _SourceDrive .. "\\RustDeskID\\AutoPlay\\Backup\\citsrust.db.back", true, true, false, true, BackUp01);
		-- File.Copy("AutoPlay\\Docs\\citsrust.db", "AutoPlay\\Backup\\citsrust.db", true, true, false, true, BackUp01);
		--File.Copy("citsrust.db", _SourceDrive.."\\SoftwareDev\\aaa-sqlite\\SQLite3\\CD_Root\\citsrust.db", true, true, false, true);
		Application.Sleep(500);
		Dialog.Message("Info", "The SQLite Rustdesk database \nhas successfully been backed up.", MB_OK, MB_ICONINFORMATION, MB_DEFBUTTON1)
else
Dialog.Message("Info", "The user chose not to \nbackup at this time.", MB_OK, MB_ICONINFORMATION, MB_DEFBUTTON1)
end
-- the feature above has been moved/amended and is working on main page On Close
-- we had to close the database connection before able to copy the citsrust.db file.</Script>
