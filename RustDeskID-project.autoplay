-- Confirm that the installation executable should be launched.
result = Dialog.Message("Confirm", "Are you sure you would like to \nrestore the Rustdesk customer database? \nThe app will exit on completion \nand will need to be restarted.", MB_YESNO, MB_ICONINFORMATION, MB_DEFBUTTON1);
-- If the user clicked the Yes button.
if (result == IDYES) then		-- close db connection.
		SQLite3Connection:close()
		SQLite3:close()
		Application.Sleep(500);
			-- Restore backup file
			File.Copy("AutoPlay\\Backup\\citsrustbak.db", _SourceDrive .. "RustdeskID\\AutoPlay\\Docs\\citsrust.db", true, true, false, true, BackUp01);
			Application.Sleep(500);
			Dialog.TimedMessage("Notice", "About to exit app", 1000, MB_ICONINFORMATION);
			Application.Exit(AppExit1);
		else
Dialog.Message("Info", "The user chose not to \nrestore the Rustdesk customer DB.", MB_OK, MB_ICONINFORMATION, MB_DEFBUTTON1)
end</Script>
