<Script>    -- Loop through the rows of the selected data
    for nRow = 1, tSelected.Rows do  
        -- Get the current row data
        local row = tSelected.Data[nRow]
        
        -- Add the 'Name' and 'id' from the current row to the ListBox
        ListBox.AddItem("ListBox1", row["Name"], row["id"])
    end
         
    -- Query the database to count the number of records in the 'RUSTDESK' table
    local tbResults = db:execute("SELECT COUNT(*) AS COUNT FROM RUSTDESK")
    Input.SetText("Input6", tbResults.Data[1]["COUNT"])</Script>
