<Event>
<Name>On Select</Name>
<Args/>
<Script>-- Get the selected item from the ListBox
local xSel = ListBox.GetSelected("ListBox1")

-- Check if an item is selected
if xSel then
    -- Get the item data (ID) of the selected item
    local nData = ListBox.GetItemData("ListBox1", xSel[1])
    local n = tonumber(nData)  -- Convert the data to a number

    -- If the data is a valid number, perform the query
    if type(n) == "number" then
         
    local SQLite3Cursor = SQLite3Connection:execute("SELECT * FROM RUSTDESK WHERE id ="..n)
    
    if SQLite3Cursor then
        -- Fetch all rows
        local row = SQLite3Cursor:fetch({}, "a")
        while row do
        
            Input.SetText("InputName2", row.Name)
            Input.SetText("Input1", tostring(row.id))
            Input.SetText("Input3", tostring(row.RustID))
            
            row = SQLite3Cursor:fetch(row, "a") -- Get the next row
        end
        SQLite3Cursor:close()
    else
        print("Error executing SQL query in SearchAll")
    end
        
          
        
    else
        -- Handle the case where the selected item ID is not a valid number (optional)
        -- Add error handling or message here if necessary
    end
else
    -- Handle the case where no item is selected in the ListBox (optional)
    -- Add error handling or message here if necessary
end
</Script>
