<Object>
<Type>20</Type>
<Name>xButtonExit1</Name>
<VisibleAtDesignTime>1</VisibleAtDesignTime>
<VisibleAtRunTime>1</VisibleAtRunTime>
<Locked>0</Locked>
<Enabled>1</Enabled>
<ToolTip>Backup database and exit app.   </ToolTip>
<Cursor>0</Cursor>
<Group>0</Group>
<MaintainAspectRatio>0</MaintainAspectRatio>
<Pin>0</Pin>
<TabIndex>-1</TabIndex>
<AutoResize>0</AutoResize>
<Coordinates>
<Top>424</Top>
<Bottom>447</Bottom>
<Left>544</Left>
<Right>619</Right>
</Coordinates>
<Ratios>
<WidthRatio>-1.000000</WidthRatio>
<HeightRatio>-1.000000</HeightRatio>
</Ratios>
<Event>
<Name>On Click</Name>
<Args/>
<Script>		xButton.SetVisible("xButtonDummy1", false);
		xButton.SetVisible("xButtonDelete9", false);
		xButton.SetVisible("xButtonModify8", false);
		Image.SetVisible("ImageHourGlass4", true);

My_Docs = Shell.GetFolder(SHF_MYDOCUMENTS);

		-- close db connection.
		SQLite3Connection:close()
		SQLite3:close()
		Application.Sleep(500);
		-- Create a backup of db
		Dialog.TimedMessage("Notice", "Backing up database now...", 1000, MB_ICONINFORMATION);
		
		File.Copy("AutoPlay\\Docs\\citsrust.db", _SourceFolder .. "\\AutoPlay\\Backup\\citsrustbak.db", true, true, false, true, BackUp01);
		Application.Sleep(500);
		
		-- This duplicates the database to the app development location, so when compiling, latest DB doesn't get overwritten. (To be removed from public version of app.)
		does_exist = File.DoesExist(_SourceDrive .. "\\SoftwareDev\\RustDeskID-project\\CD_Root\\AutoPlay\\Docs\\citsrust.db");
			if (does_exist == true) then
		File.Copy("AutoPlay\\Docs\\citsrust.db", _SourceDrive .. "\\SoftwareDev\\RustDeskID-project\\CD_Root\\AutoPlay\\Docs\\citsrust.db", true, true, false, true, BackUp03);
		Application.Sleep(500);
		Dialog.TimedMessage("Notice", "Back up of database local developers database complete.", 100, MB_ICONINFORMATION);
		else
		Dialog.TimedMessage("Notice", "Back up of developer database not needed.", 100, MB_ICONINFORMATION);
		end
				
		-- Copy database to user's documents folder
		File.Copy("AutoPlay\\Docs\\citsrust.db", My_Docs .. "\\citsrustbak.db", true, true, false, true, BackUp05);
		Dialog.TimedMessage("Notice", "Back up of database to user's document folder complete.", 500, MB_ICONINFORMATION);
		
		Image.SetVisible("ImageHourGlass4", false);

		Dialog.TimedMessage("Notice", "Exiting now...", 500, MB_ICONINFORMATION);
		Application.Exit(eXiit);</Script>
