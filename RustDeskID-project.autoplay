<DesignCodeCol>0</DesignCodeCol>
<BookMarks count="0">
</BookMarks>
</Event>
<Event>
<Name>On Show</Name>
<Args/>
<Script>-- Hide Hourglass.
Image.SetVisible("ImageHourGlass4", false);

-- Page.SetFocus("xButtonSearch4"); -- still a work in progress when entering search, this button still doesn't respond as desired .. solution pending


-- Function to search and display all rows from the database
function SearchAll()
    -- Clear all items from the ListBox before adding new ones
    ListBox.DeleteItem("ListBox1", LB_ALLITEMS)

    -- Retrieve a cursor
    local SQLite3Cursor = SQLite3Connection:execute("SELECT id, Name FROM RUSTDESK")
    
    if SQLite3Cursor then
        -- Fetch all rows
        local row = SQLite3Cursor:fetch({}, "a")
        while row do
            ListBox.AddItem("ListBox1", row.Name, row.id)
            row = SQLite3Cursor:fetch(row, "a") -- Get the next row
        end
        SQLite3Cursor:close()
    else
        print("Error in SQL Search All")
    end  
end



-- Function to search and display filtered rows from the database
function Search(sch)
    -- Clear all items from the ListBox before adding new ones
    ListBox.DeleteItem("ListBox1", LB_ALLITEMS)

    -- Prepare the search query
    local query = string.format("SELECT id, Name FROM RUSTDESK WHERE id LIKE '%%%s%%' OR Name LIKE '%%%s%%'", sch, sch)
    local SQLite3Cursor = SQLite3Connection:execute(query)

    if SQLite3Cursor then
        -- Fetch all rows
        local row = SQLite3Cursor:fetch({}, "a")
        while row do
            ListBox.AddItem("ListBox1", row.Name, row.id)
            row = SQLite3Cursor:fetch(row, "a") -- Get the next row
        end
        SQLite3Cursor:close()
    else
        print("Error in search")
    end
end

-- Call the function to perform the initial search
SearchAll()


</Script>
