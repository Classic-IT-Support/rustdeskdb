<Script>		-- Confirm that the installation executable should be launched.
result = Dialog.Message("Confirm", "Are you sure you would like to \nbackup Rustdesk db? \nPlease restart app when complete.", MB_YESNO, MB_ICONINFORMATION, MB_DEFBUTTON1);
-- If the user clicked the Yes button.
if (result == IDYES) then

		-- close db connection.
		--SQLite3Connection:close()
		--SQLite3:close()
		-- Create a backup of db
		File.Copy("AutoPlay\\Docs\\citsrust.db", _SourceFolder .. "AutoPlay\\Backup\\citsrust.bak", true, true, false, true, BackUp01);
		Application.Sleep(500);
		-- File.Copy(_SourceDrive .."\\RustDeskID\\AutoPlay\\Docs\\citsrust.db", _SourceDrive .. "\\Classic\\CD_Root\\Setup\\Remote\\Rustdesk\\citsrust.db.bak", true, true, false, true, BackUp02);
		File.Copy("AutoPlay\\Docs\\citsrust.db", _SourceDrive .. "\\SoftwareDev\\RustDeskID-project\\CD_Root\\AutoPlay\\Docs\\citsrust.db", true, true, false, true, BackUp03)
		
		File.ExploreFolder(_SourceDrive .. "\\RustdeskID\\AutoPlay\\Backup", SW_SHOWNORMAL);
		
					Application.Exit(AppExit1);
					
					else
				Dialog.Message("Info", "The user chose not to \nbackup this time.", MB_OK, MB_ICONINFORMATION, MB_DEFBUTTON1);
end</Script>
