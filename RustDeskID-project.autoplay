<Event>
<Name>On Key</Name>
<Args>number e_Key, table e_Modifiers</Args>
<Script>-- e_Key is a built in variable that gets generated by the On Key event.
-- 13 is the virtual key code value for the [Enter] key.

if e_Key == 13 then
    -- Enter the input by the user:
    Search(Input.GetText("InputSearchAll4"))
end

</Script>
