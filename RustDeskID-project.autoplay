<Event>
<Name>On Click</Name>
<Args/>
<Script>local sqlite = require("luasql.sqlite3")
local db = sqlite.open("AutoPlay\\Docs\\citsrust.db")
local csvfile = io.open("AutoPlay\\Docs\\export_data.csv", "w")

-- Write headers 
csv_file:write("col1,col2,col3\n")

-- Fetch and write data
for row in db:rows("SELECT * FROM RUSTDESK") do
    csvfile:write(string.format("%s,%s,%s\n", row[1], row[2], row[3]))
end

csvfile:close()
db:close()</Script>
