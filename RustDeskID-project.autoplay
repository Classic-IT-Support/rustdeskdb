<Event>
<Name>On Startup</Name>
<Args/>
<Script>-- gets the applications running name
nHandle = Application.GetWndHandle();
		-- check to see if screen location save exists
		iniexist = Registry.DoesKeyExist (HKEY_CURRENT_USER, "Software\\ClassicIT\\RustdeskID\\Screen");
		if iniexist == true then
				-- retrieve from INI file the saved app screen position
				posx = Registry.GetValue(HKEY_CURRENT_USER, "Software\\ClassicIT\\RustdeskID\\Screen", "POSX", true);
				posy = Registry.GetValue(HKEY_CURRENT_USER, "Software\\ClassicIT\\RustdeskID\\Screen", "POSY", true);
				-- Set app position at the same location as when previously closed.
				Window.SetPos(nHandle, posx, posy); 
				else

-- Set app to top right of screen
sLocation = "TopRight";

nHandle = Application.GetWndHandle();

tWindowSize = Window.GetSize(nHandle);
tScreenSize = System.GetDisplayInfo();

if sLocation == "TopLeft" then
nX = 0;
nY = 0;
elseif sLocation == "TopRight" then
nX = tScreenSize.Width-tWindowSize.Width;
nY = 0;
elseif sLocation == "BottomLeft" then
nX = 0;
nY = tScreenSize.Height-tWindowSize.Height;
elseif sLocation == "BottomRight" then
nX = tScreenSize.Width-tWindowSize.Width;
nY = tScreenSize.Height-tWindowSize.Height;
end

Window.SetPos(nHandle, nX-10, nY+150); 

end</Script>
